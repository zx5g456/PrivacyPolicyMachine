# Copy this file to config/base-mainnet.env, then fill in the values there.
# The filled file is ignored by Git. Never commit private keys or an RPC API key.
# Base Mainnet only. No testnet or local-chain RPC is accepted by the app.
# Use a Base Mainnet HTTPS RPC that supports eth_getLogs at your expected volume.
# The public mainnet.base.org endpoint can return HTTP 429 during event indexing.
RPC_URL=
EXPECTED_CHAIN_ID=8453

# Fill these from npm run base:deploy, or from a deployment you have verified.
CONTRACT_ADDRESS=
CONTRACT_DEPLOYMENT_BLOCK=
CONTRACT_RUNTIME_CODE_HASH=

# The deployer pays for contract creation and role setup. Only base:deploy uses
# this key; npm run dev does not pass it to the web server or listener.
BASE_DEPLOYER_PRIVATE_KEY=
# Optional future owner (for example a multisig). The deployer proposes the
# transfer after role setup; that address must call acceptOwnership separately.
BASE_OWNER_ADDRESS=

# Developer wallets pay for their own policy uploads in the browser. Do not put
# their private keys here. Each name must match the UI developer name exactly.
PUBLISHER_WALLETS_JSON='{"alice":"","bob":"","charlie":""}'

# The compliance wallet pays for its on-chain ZIP upload. It must hold Base ETH.
# It is authorized by base:deploy and signs locally inside the listener.
COMPLIANCE_PRIVATE_KEY=

# Required to run the P1/P2/P3 compliance pipeline after registration.
OPENAI_API_KEY=

# Optional local-service settings: uncomment and adjust when needed.
# OLLAMA_MODEL=qwen3.5:9b
# COMPLIANCE_GPT_MODEL=gpt-4o-mini
# COMPLIANCE_HIGH_RISK=auto
# ONCHAIN_CHUNK_BYTES=4096
# COMPLIANCE_CHUNK_BYTES=4096
# COMPLIANCE_MAX_BUNDLE_BYTES=1048576
# EVENT_CONFIRMATIONS=3
# POLL_INTERVAL_MS=5000
# BLOCK_BATCH_SIZE=1000
# PORT=8000
